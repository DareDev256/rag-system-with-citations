# Required: OpenAI API Key
OPENAI_API_KEY=sk-your-key-here

# Model Configuration (defaults shown)
SYNTHESIS_MODEL=gpt-4o-mini
CLASSIFICATION_MODEL=gpt-4o-mini

# Logging
LOG_LEVEL=INFO

# Optional: Custom index path
INDEX_PATH=src/data/vector_store.index
DO_EVAL=False

# Security: CORS allowed origins (comma-separated, empty = no CORS)
CORS_ORIGINS=

# Security: Set to any value to disable Swagger/ReDoc docs in production
# DISABLE_DOCS=1
